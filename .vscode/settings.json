{
    "basedpyright.pythonPath": "/home/henrig/.conda/envs/j3/bin/python",
    "python.defaultInterpreterPath": "/home/henrig/.conda/envs/j3/bin/python",
    "python-envs.defaultEnvManager": "ms-python.python:conda",
    "python-envs.defaultPackageManager": "ms-python.python:conda",
    // Pylance Type Checking & Import Analysis Settings
    "python.analysis.typeCheckingMode": "basic", // Options: "off", "basic", "strict"
    "python.analysis.diagnosticMode": "workspace", // Analyzes all files, not just open ones
    "python.analysis.autoImportCompletions": true,
    // Provide additional inlay hints for types
    "python.analysis.inlayHints.variableTypes": true,
    "python.analysis.inlayHints.functionReturnTypes": true,
    // Highlight unused imports/variables
    "python.analysis.diagnosticSeverityOverrides": {
        "reportUnusedImport": "warning",
        "reportMissingImports": "error"
    },
    // File Watcher Exclusions (Fixes "Unable to watch for file changes")
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/data/**": true,
        "**/checkpoints/**": true,
        "**/logs/**": true,
        "**/experiments/**": true,
        "**/outputs/**": true,
        "**/predictions/**": true,
        "**/results/**": true
    },
    // Formatting settings
    "editor.formatOnSave": true,
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnType": true
    },
    "[latex]": {
        "editor.defaultFormatter": "James-Yu.latex-workshop",
        "editor.formatOnSave": true
    },
    "latex-workshop.latex.autoBuild.run": "onFileChange",
    // Enable Semantic Highlighting (richer colors from the language server)
    "editor.semanticHighlighting.enabled": true,
}